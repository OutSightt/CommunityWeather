{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run CommunityWeather",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net8.0/CommunityWeather.dll",
      "cwd": "${workspaceFolder}",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development", "ASPNETCORE_URLS": "https://localhost:7080;http://localhost:5080" },
      "serverReadyAction": { "action": "openExternally", "pattern": "Now listening on: (https?://\\S+)" }
    }
  ]
}
