@model List<PreparednessGuide>
@{
    ViewData["Title"] = "Manage guides";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0" style="font-size:1.9rem">Manage guides</h1>
    <a asp-action="Create" class="btn btn-primary">New guide</a>
</div>
<table class="table table-sm align-middle">
    <thead><tr><th>Title</th><th>Hazard</th><th>Updated</th><th></th></tr></thead>
    <tbody>
    @foreach (var g in Model)
    {
        <tr>
            <td>@g.Title</td>
            <td>@g.Hazard</td>
            <td>@g.UpdatedAt.ToString("MMM d, yyyy")</td>
            <td class="text-nowrap">
                <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                <form asp-action="Delete" asp-route-id="@g.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this guide?');">
                    <button class="btn btn-outline-danger btn-sm">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
