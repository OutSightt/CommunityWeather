@model List<EvacuationCenter>
@{
    ViewData["Title"] = "Manage locations";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0" style="font-size:1.9rem">Manage locations</h1>
    <a asp-action="Create" class="btn btn-primary">Add location</a>
</div>
<div class="table-responsive">
<table class="table table-sm align-middle">
    <thead><tr><th>Name</th><th>Type</th><th>Address</th><th>Contact</th><th>Map</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Name</td>
            <td>@c.FacilityType</td>
            <td>@c.Address</td>
            <td>@c.ContactNumber</td>
            <td>@(c.Latitude.HasValue ? "Placed" : "Missing coordinates")</td>
            <td class="text-nowrap">
                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this location?');">
                    <button class="btn btn-outline-danger btn-sm">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
