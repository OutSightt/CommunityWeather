@model List<EvacuationCenter>
@{
    ViewData["Title"] = "Evacuation map";
    var mapsKey = ViewBag.MapsKey as string ?? "";
    var useGoogle = !string.IsNullOrWhiteSpace(mapsKey);   // Google Maps when a key is set, otherwise OpenStreetMap
    var types = Model.Select(c => c.FacilityType).Distinct().OrderBy(t => t).ToList();
    var mapped = Model.Where(c => c.Latitude.HasValue && c.Longitude.HasValue)
        .Select(c => new { c.Id, c.Name, c.Address, c.ContactNumber, c.FacilityType, c.OperationalNotes, lat = c.Latitude, lng = c.Longitude })
        .ToList();
}
@section Head {
    @if (!useGoogle)
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    }
}

<h1>Evacuation map</h1>
<p class="lede">Evacuation centers and public facilities kept up to date by your community administrators. Confirm with your barangay before you travel.</p>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <button type="button" class="btn btn-primary" id="locate-me">Show my location</button>
    <span id="locate-status" class="small text-muted" role="status">Share your location to sort places by distance.</span>
</div>

@if (types.Count > 1)
{
    <div class="chips" role="group" aria-label="Filter by facility type">
        <button type="button" class="chip" data-filter="" aria-pressed="true">All</button>
        @foreach (var t in types)
        {
            <button type="button" class="chip" data-filter="@t" aria-pressed="false">@t</button>
        }
    </div>
}

<div class="finder">
    <div class="finder-list" id="place-list">
        @foreach (var c in Model)
        {
            <button type="button" class="place" data-id="@c.Id" data-type="@c.FacilityType">
                <span class="place-name">@c.Name</span>
                <span class="place-type">@c.FacilityType</span>
                <small>@c.Address</small>
                <small class="place-dist" hidden></small>
                @if (!string.IsNullOrWhiteSpace(c.ContactNumber)) { <small>Contact: @c.ContactNumber</small> }
                @if (!string.IsNullOrWhiteSpace(c.OperationalNotes)) { <small>@c.OperationalNotes</small> }
                @if (!c.Latitude.HasValue) { <small>Not on the map yet. An administrator needs to add its coordinates.</small> }
            </button>
        }
        @if (!Model.Any())
        {
            <div class="empty">No locations have been added yet. Administrators can add evacuation centers from the Manage menu.</div>
        }
    </div>
    <div class="finder-map"><div id="map" class="map-box" role="application" aria-label="Map of evacuation centers"></div></div>
</div>

@section Scripts {
    @if (!useGoogle)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    }
    <script>
        const centers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mapped));
        const useGoogle = @(useGoogle ? "true" : "false");
        const START = [10.3157, 123.8854];
        const markers = {};
        let map, info, youMarker;

        function km(a, b) {
            const r = Math.PI / 180, R = 6371;
            const dLat = (b.lat - a.lat) * r, dLng = (b.lng - a.lng) * r;
            const h = Math.sin(dLat / 2) ** 2 + Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin(dLng / 2) ** 2;
            return 2 * R * Math.asin(Math.sqrt(h));
        }

        function popupContent(c) {
            const div = document.createElement("div");
            const b = document.createElement("strong"); b.textContent = c.name; div.appendChild(b);
            [c.facilityType, c.address, c.contactNumber ? "Contact: " + c.contactNumber : "", c.operationalNotes]
                .filter(Boolean).forEach(t => { const p = document.createElement("div"); p.textContent = t; div.appendChild(p); });
            return div;
        }

        // ----- Map provider: Google Maps when a key is set, otherwise Leaflet with OpenStreetMap -----
        function createMap() {
            const first = centers.length ? [centers[0].lat, centers[0].lng] : START;
            if (useGoogle) {
                map = new google.maps.Map(document.getElementById("map"), {
                    center: { lat: first[0], lng: first[1] }, zoom: 13, mapTypeControl: false, streetViewControl: false
                });
                info = new google.maps.InfoWindow();
            } else {
                map = L.map("map").setView(first, 13);
                L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    maxZoom: 19,
                    attribution: "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
                }).addTo(map);
            }
            centers.forEach(c => { markers[c.id] = addMarker(c); });
            fitTo(centers.map(c => [c.lat, c.lng]));
        }

        function addMarker(c) {
            let m;
            if (useGoogle) {
                m = new google.maps.Marker({ position: { lat: c.lat, lng: c.lng }, map, title: c.name });
                m.addListener("click", () => openPlace(c.id, false));
            } else {
                m = L.marker([c.lat, c.lng], { title: c.name }).addTo(map);
                m.on("click", () => openPlace(c.id, false));
            }
            m.facilityType = c.facilityType;
            return m;
        }

        function setMarkerVisible(m, visible) {
            if (useGoogle) m.setVisible(visible);
            else if (visible) m.addTo(map); else m.remove();
        }

        function closeInfo() {
            if (useGoogle) { if (info) info.close(); }
            else if (map) map.closePopup();
        }

        function fitTo(points) {
            if (!map || points.length === 0) return;
            if (useGoogle) {
                if (points.length === 1) return;
                const b = new google.maps.LatLngBounds();
                points.forEach(p => b.extend({ lat: p[0], lng: p[1] }));
                map.fitBounds(b, 80);
            } else if (points.length === 1) {
                map.setView(points[0], 15);
            } else {
                map.fitBounds(points, { padding: [40, 40], maxZoom: 16 });
            }
        }

        function openPlace(id, pan) {
            document.querySelectorAll(".place").forEach(el => el.classList.toggle("is-active", Number(el.dataset.id) === id));
            const c = centers.find(x => x.id === id), m = markers[id];
            if (!map || !c || !m) return;
            if (useGoogle) {
                info.setContent(popupContent(c));
                info.open(map, m);
                if (pan) { map.panTo(m.getPosition()); map.setZoom(16); }
            } else {
                m.bindPopup(popupContent(c)).openPopup();
                if (pan) map.setView([c.lat, c.lng], 16);
            }
        }

        function showMe(me) {
            if (!map) return;
            if (youMarker) { if (useGoogle) youMarker.setMap(null); else youMarker.remove(); }
            if (useGoogle) {
                youMarker = new google.maps.Marker({
                    position: me, map, title: "You are here", zIndex: 999,
                    icon: { path: google.maps.SymbolPath.CIRCLE, scale: 9, fillColor: "#0E6E8C", fillOpacity: 1, strokeColor: "#fff", strokeWeight: 3 }
                });
            } else {
                youMarker = L.circleMarker([me.lat, me.lng], { radius: 9, color: "#ffffff", weight: 3, fillColor: "#0E6E8C", fillOpacity: 1 }).addTo(map);
                youMarker.bindTooltip("You are here");
            }
        }

        // ----- Page behaviour -----
        document.querySelectorAll(".place").forEach(el =>
            el.addEventListener("click", () => openPlace(Number(el.dataset.id), true)));

        document.querySelectorAll(".chip[data-filter]").forEach(chip => chip.addEventListener("click", () => {
            const f = chip.dataset.filter;
            document.querySelectorAll(".chip[data-filter]").forEach(c => c.setAttribute("aria-pressed", c === chip ? "true" : "false"));
            document.querySelectorAll(".place").forEach(el => el.hidden = f && el.dataset.type !== f);
            Object.values(markers).forEach(m => setMarkerVisible(m, !f || m.facilityType === f));
            closeInfo();
        }));

        // Show the visitor's own location, then sort places by distance.
        document.getElementById("locate-me").addEventListener("click", () => {
            const status = document.getElementById("locate-status");
            if (!navigator.geolocation) { status.textContent = "Your browser cannot share its location."; return; }
            status.textContent = "Finding you...";
            navigator.geolocation.getCurrentPosition(pos => {
                const me = { lat: pos.coords.latitude, lng: pos.coords.longitude };
                const list = document.getElementById("place-list");
                const sorted = centers.map(c => ({ c, d: km(me, c) })).sort((a, b) => a.d - b.d);

                sorted.forEach(x => {
                    const el = list.querySelector('.place[data-id="' + x.c.id + '"]');
                    if (!el) return;
                    const dist = el.querySelector(".place-dist");
                    dist.textContent = x.d.toFixed(1) + " km from you";
                    dist.hidden = false;
                });
                // Put the nearest place at the top of the list.
                sorted.slice().reverse().forEach(x => {
                    const el = list.querySelector('.place[data-id="' + x.c.id + '"]');
                    if (el) list.insertBefore(el, list.firstChild);
                });

                showMe(me);
                const points = [[me.lat, me.lng]];
                if (sorted.length) points.push([sorted[0].c.lat, sorted[0].c.lng]);
                fitTo(points);
                if (sorted.length) openPlace(sorted[0].c.id, false);

                status.textContent = sorted.length
                    ? "Nearest: " + sorted[0].c.name + ", " + sorted[0].d.toFixed(1) + " km away."
                    : "Your location was found, but no places have map coordinates yet.";
            }, () => {
                status.textContent = "Location was blocked. Allow location access for this site in your browser and try again.";
            }, { timeout: 10000 });
        });

        @if (!useGoogle)
        {
            <text>createMap();</text>
        }
        else
        {
            <text>window.initMap = createMap;</text>
        }
    </script>
    @if (useGoogle)
    {
        <script async src="https://maps.googleapis.com/maps/api/js?key=@Uri.EscapeDataString(mapsKey)&callback=initMap"></script>
    }
}
