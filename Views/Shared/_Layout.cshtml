@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var fullBleed = ViewData["FullBleed"] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Community Weather</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<nav class="navbar navbar-expand-lg site-nav">
    <div class="container">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <svg viewBox="0 0 32 32" aria-hidden="true">
                <circle cx="16" cy="16" r="14" fill="#0B2239" />
                <path d="M5 19a11 11 0 0 1 22 0" fill="none" stroke="#F2B632" stroke-width="2.5" stroke-linecap="round" />
                <path d="M16 19 L22 11" stroke="#fff" stroke-width="2.5" stroke-linecap="round" />
                <circle cx="16" cy="19" r="2.2" fill="#fff" />
            </svg>
            Community Weather
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto ms-lg-3">
                <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Weather</a></li>
                <li class="nav-item"><a class="nav-link @Active("Advisories")" asp-controller="Advisories" asp-action="Index">Advisories</a></li>
                <li class="nav-item"><a class="nav-link @Active("Centers")" asp-controller="Centers" asp-action="Index">Evacuation map</a></li>
                <li class="nav-item"><a class="nav-link @Active("Guides")" asp-controller="Guides" asp-action="Index">Prepare</a></li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item"><a class="nav-link @(controller is "Admin" or "Resident" ? "active" : "")" asp-controller="Account" asp-action="Dashboard">Dashboard</a></li>
                }
                @if (User.IsInRole(Roles.Admin))
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" role="button">Manage</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">Users and roles</a></li>
                            <li><a class="dropdown-item" asp-controller="Advisories" asp-action="Manage">Advisories</a></li>
                            <li><a class="dropdown-item" asp-controller="Centers" asp-action="Manage">Locations</a></li>
                            <li><a class="dropdown-item" asp-controller="Guides" asp-action="Manage">Guides</a></li>
                        </ul>
                    </li>
                }
            </ul>
            <ul class="navbar-nav align-items-lg-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Profile">
                            @User.Identity.Name
                            <span class="tag @(User.IsInRole(Roles.Admin) ? "tag-admin" : "")">@(User.IsInRole(Roles.Admin) ? "Administrator" : "Resident")</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-link nav-link">Log out</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                    <li class="nav-item"><a class="btn btn-primary ms-lg-2" asp-controller="Account" asp-action="Register">Create account</a></li>
                }
            </ul>
        </div>
    </div>
</nav>

@if (TempData["Message"] != null || TempData["Warning"] != null)
{
    <div class="container flash">
        @if (TempData["Message"] is string m) { <div class="alert alert-success" role="status">@m</div> }
        @if (TempData["Warning"] is string w) { <div class="alert alert-warning" role="alert">@w</div> }
    </div>
}

<main id="main">
    @if (fullBleed)
    {
        @RenderBody()
    }
    else
    {
        <div class="container page">@RenderBody()</div>
    }
</main>

<footer class="site-footer">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-7">
                <h2>Use this alongside official warnings</h2>
                <p class="mb-0" style="max-width:60ch">This site supports public awareness and preparedness. It does not replace bulletins from PAGASA, your local government unit, or emergency services. If you are in danger, follow official instructions.</p>
            </div>
            <div class="col-md-5">
                <h2>Emergency numbers</h2>
                <ul class="hotlines">
                    <li><span>National emergency hotline</span><b>911</b></li>
                    <li><span>Philippine Red Cross</span><b>143</b></li>
                </ul>
                <p class="small mt-2 mb-0">Check with your barangay or city hall for local hotlines.</p>
            </div>
        </div>
    </div>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
